    GuardianExt -> System [label="Portal Access
(Child Switcher, Multi-student view)"];
    InstructorExt -> System [label="Cockpit + Desk
(Attendance, Marks, Schedule)"];
    AdmissionsExt -> System [label="Cockpit + Desk
(Inquiry→Applicant→Approval)"];
    FeeMgrExt -> System [label="Cockpit + Desk
(Fees, Payments, Discounts, Reports)"];
    FacilityExt -> System [label="Cockpit + Desk
(Library, Hostel, Transport)"];
    CommExt -> System [label="Cockpit + Desk
(Notices, Feedback, Dashboard)"];
    AcademicExt -> System [label="Cockpit + Desk
(Academics Overview, Attendance, Exams)"];
    SysMgrExt -> System [label="Admin Cockpit + Desk
(Institution-wide, All Modules)"];
    
    System -> DB [label="Read/Write
All DocTypes", dir=both];
}
